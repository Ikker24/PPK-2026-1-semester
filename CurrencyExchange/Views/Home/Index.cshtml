@model CurrencyExchange.Models.ViewModels.RatesViewModel
@{
    ViewData["Title"] = "Курсы валют";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-currency-exchange text-primary me-2"></i>Текущие курсы валют</h1>
        @if (Model.LastUpdated.HasValue)
        {
            <small class="text-muted">
                Обновлено: @Model.LastUpdated.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            </small>
        }
        else
        {
            <small class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Курсы не загружены</small>
        }
    </div>
    <form method="post" action="/Home/RefreshRates">
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-arrow-clockwise me-1"></i>Обновить курсы
        </button>
    </form>
</div>

@if (!Model.Rates.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Курсы ещё не загружены. Нажмите «Обновить курсы» для получения актуальных данных.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var rate in Model.Rates)
        {
            var currency = Model.Currencies.FirstOrDefault(c => c.Id == rate.CurrencyId);
            if (currency == null) continue;
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-primary fs-6 me-2">@currency.Code</span>
                                <span class="text-muted small">@currency.Name</span>
                            </div>
                            <span class="display-6 text-muted">@currency.Symbol</span>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="text-success fw-bold fs-5">@rate.BuyRate.ToString("N2")</div>
                                <div class="text-muted small">Покупка</div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary fw-bold fs-5">@rate.MidRate.ToString("N2")</div>
                                <div class="text-muted small">ЦБ</div>
                            </div>
                            <div class="col-4">
                                <div class="text-danger fw-bold fs-5">@rate.SellRate.ToString("N2")</div>
                                <div class="text-muted small">Продажа</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
