@model CurrencyExchange.Models.ViewModels.CurrenciesManageViewModel
@{
    ViewData["Title"] = "Валюты";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-cash-coin text-primary me-2"></i>Валюты и маржа</h1>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Супер-режим: добавление по коду</h6>
            </div>
            <div class="card-body">
                <form method="post" action="/Currencies/AddByCode">
                    <div class="mb-3">
                        <label class="form-label">Код валюты</label>
                        <input name="code" class="form-control form-control-lg" placeholder="Например: USD" maxlength="6" required />
                        <div class="form-text">Символ и название будут равны коду (можно изменить в модели/коде позже).</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Маржа покупки, %</label>
                        <input name="buyMargin" type="number" step="0.1" min="0" class="form-control" value="@Model.BuyMargin" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Маржа продажи, %</label>
                        <input name="sellMargin" type="number" step="0.1" min="0" class="form-control" value="@Model.SellMargin" />
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-shuffle me-2"></i>Добавить и перейти к обмену
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-list-ul me-2"></i>Список валют</h6>
                <span class="text-muted small">Курсы подтягиваются автоматически при открытии страниц/обмене</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Код</th>
                                <th>Активна</th>
                                <th class="text-end">Купля %</th>
                                <th class="text-end">Продажа %</th>
                                <th class="text-end">ЦБ</th>
                                <th class="text-end">Покупка</th>
                                <th class="text-end">Продажа</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        @item.Code
                                        @if (item.IsBase)
                                        {
                                            <span class="badge bg-primary ms-2">base</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "да" : "нет")</span>
                                    </td>
                                    <td class="text-end">@item.BuyMargin.ToString("N2")%</td>
                                    <td class="text-end">@item.SellMargin.ToString("N2")%</td>
                                    <td class="text-end text-muted">@(item.MidRate.HasValue ? item.MidRate.Value.ToString("N2") : "—")</td>
                                    <td class="text-end text-success fw-semibold">@(item.BuyRate.HasValue ? item.BuyRate.Value.ToString("N2") : "—")</td>
                                    <td class="text-end text-danger fw-semibold">@(item.SellRate.HasValue ? item.SellRate.Value.ToString("N2") : "—")</td>
                                    <td class="text-end">
                                        @if (item.IsBase)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/Currencies/Deactivate" style="display:inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary me-2">
                                                    <i class="bi bi-slash-circle me-1"></i>Отключить
                                                </button>
                                            </form>
                                            <form method="post" action="/Currencies/Delete" style="display:inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash me-1"></i>Удалить
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
